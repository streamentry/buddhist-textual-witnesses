{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Human review of a multi-witness alignment",
  "type": "object",
  "required": [
    "review_id",
    "case_study_id",
    "alignment_id",
    "reviewer",
    "decision",
    "assessments",
    "reviewed_on",
    "notes"
  ],
  "properties": {
    "review_id": {
      "type": "string",
      "minLength": 1
    },
    "case_study_id": {
      "type": "string",
      "minLength": 1
    },
    "alignment_id": {
      "type": "string",
      "minLength": 1
    },
    "reviewer": {
      "type": "object",
      "required": [
        "reviewer_type",
        "name"
      ],
      "properties": {
        "reviewer_type": {
          "const": "human"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "affiliation": {
          "type": [
            "string",
            "null"
          ]
        },
        "identifier": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "decision": {
      "enum": [
        "accepted",
        "rejected",
        "needs_work"
      ]
    },
    "assessments": {
      "type": "object",
      "required": [
        "source_units",
        "relation_type",
        "variant_notes",
        "editorial_handling"
      ],
      "properties": {
        "source_units": {
          "enum": [
            "agree",
            "revise",
            "uncertain"
          ]
        },
        "relation_type": {
          "enum": [
            "agree",
            "revise",
            "uncertain"
          ]
        },
        "variant_notes": {
          "enum": [
            "agree",
            "revise",
            "uncertain"
          ]
        },
        "editorial_handling": {
          "enum": [
            "agree",
            "revise",
            "uncertain"
          ]
        }
      },
      "additionalProperties": false
    },
    "reviewed_on": {
      "type": "string",
      "minLength": 10
    },
    "notes": {
      "type": "string"
    },
    "proposed_changes": {
      "type": [
        "object",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
