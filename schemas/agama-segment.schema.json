{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CBETA Agama discourse segment",
  "type": "object",
  "required": [
    "canonical_id",
    "collection",
    "container_id",
    "number",
    "mulu_text",
    "hierarchy",
    "source",
    "locator"
  ],
  "properties": {
    "canonical_id": {"type": "string"},
    "collection": {"enum": ["DA", "MA", "SA", "SA2", "EA"]},
    "container_id": {"enum": ["T0001", "T0026", "T0099", "T0100", "T0125"]},
    "number": {"type": "integer", "minimum": 1},
    "title": {"type": ["string", "null"]},
    "mulu_text": {"type": "string"},
    "head_text": {"type": ["string", "null"]},
    "hierarchy": {"type": "array", "items": {"type": "object"}},
    "source": {
      "type": "object",
      "required": ["project", "path", "revision", "url"],
      "properties": {
        "project": {"const": "CBETA XML-P5 / Taishō"},
        "path": {"type": "string"},
        "revision": {"type": "string", "minLength": 40},
        "url": {"type": "string"}
      },
      "additionalProperties": false
    },
    "locator": {
      "type": "object",
      "required": [
        "xpath",
        "segment_ordinal",
        "start_lb",
        "end_lb",
        "start_ref",
        "end_ref",
        "xml_sha256",
        "normalized_text_sha256",
        "normalized_text_chars"
      ],
      "properties": {
        "xpath": {"type": "string"},
        "segment_ordinal": {"type": "integer", "minimum": 1},
        "start_lb": {"type": "string"},
        "end_lb": {"type": "string"},
        "start_ref": {"type": "string"},
        "end_ref": {"type": "string"},
        "start_juan": {"type": ["string", "null"]},
        "end_juan": {"type": ["string", "null"]},
        "xml_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "normalized_text_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "normalized_text_chars": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
