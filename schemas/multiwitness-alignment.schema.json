{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Multi-witness textual alignment",
  "type": "object",
  "required": [
    "alignment_id",
    "work_id",
    "status",
    "relation_type",
    "members",
    "variants",
    "review"
  ],
  "properties": {
    "alignment_id": {"type": "string", "minLength": 1},
    "work_id": {"type": "string", "minLength": 1},
    "status": {
      "enum": ["machine_candidate", "model_reviewed", "established", "rejected"]
    },
    "relation_type": {
      "enum": [
        "parallel_passage",
        "partial_overlap",
        "structural_correspondence",
        "recension_divergence"
      ]
    },
    "scope": {"type": "string"},
    "members": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "member_id",
          "language",
          "witness_id",
          "source_unit_ids",
          "coverage"
        ],
        "properties": {
          "member_id": {"type": "string", "minLength": 1},
          "language": {"type": "string", "minLength": 1},
          "witness_id": {"type": "string", "minLength": 1},
          "source_unit_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "coverage": {
            "enum": ["full", "partial", "context", "lost_text_marker"]
          },
          "notes": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    },
    "variants": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "statement", "member_ids"],
        "properties": {
          "type": {
            "enum": [
              "expansion",
              "compression",
              "omission",
              "addition",
              "reordering",
              "lexical",
              "numerical",
              "structural",
              "textual_loss",
              "doctrinal_framing"
            ]
          },
          "statement": {"type": "string", "minLength": 1},
          "member_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        },
        "additionalProperties": false
      }
    },
    "review": {
      "type": "object",
      "required": [
        "status",
        "reviewer_type",
        "reviewer",
        "decision",
        "confidence",
        "notes"
      ],
      "properties": {
        "status": {"enum": ["unreviewed", "reviewed"]},
        "reviewer_type": {
          "type": ["string", "null"],
          "enum": ["human", "model", null]
        },
        "reviewer": {"type": ["string", "null"]},
        "decision": {
          "type": ["string", "null"],
          "enum": ["accepted", "rejected", "needs_work", null]
        },
        "confidence": {
          "type": ["string", "null"],
          "enum": ["low", "medium", "medium_high", "high", null]
        },
        "reviewed_on": {"type": ["string", "null"]},
        "notes": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
